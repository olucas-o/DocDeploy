{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node", "jest"],
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
